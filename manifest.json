{
  "manifest_version": 3,
  "name": "AnyModel - 3D Modeling Studio",
  "version": "1.0.0",
  "description": "Advanced 3D modeling software with AI capabilities, manual tools, and multi-format export support",
  "action": {
    "default_popup": "popup.html",
    "default_title": "AnyModel 3D Studio"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://*.openai.com/*",
    "https://*.huggingface.co/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["models/*"],
      "matches": ["<all_urls>"]
    }
  ]
}